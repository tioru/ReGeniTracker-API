datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Character {
  id                 Int                    @id @default(autoincrement())
  name               String                 @unique
  rarity             Int
  vision             String
  weapon             String
  nation             String
  birthday           DateTime?
  releaseDate        DateTime?
  obtaining          ObtainingTypes[]
  levels             CharacterLevel[]
  translations       CharacterTranslation[]
  ascensionMaterials AscensionMaterial[]
  normalAttacks      NormalAttack[]
  elementalSkills    ElementalSkill[]
  elementalBursts    ElementalBurst[]
  passiveTalents     PassiveTalent[]
  ascensionTalents   AscensionTalent[]
  additionalTalents  AdditionalTalent[]
  constellations     Constellation[]
  materialUses CharacterMaterialUse[]
  banners BannerCharacter[]
}

model CharacterLevel {
  id             Int       @id @default(autoincrement())
  level          String
  baseHp         Int
  baseDef        Int
  baseAtk        Int
  energyRecharge String
  character      Character @relation(fields: [characterId], references: [id])
  characterId    Int
}

model CharacterTranslation {
  id            Int       @id @default(autoincrement())
  language      String
  title         String?
  description   String?
  affiliation   String?
  constellation String?
  specialDish   String?
  character     Character @relation(fields: [characterId], references: [id])
  characterId   Int

  @@unique([characterId, language])
}

model AscensionMaterial {
  id          Int                     @id @default(autoincrement())
  level       Int
  character   Character               @relation(fields: [characterId], references: [id])
  characterId Int
  items       AscensionMaterialItem[]
}

model AscensionMaterialItem {
  id                  Int               @id @default(autoincrement())
  quantity            Int
  ascensionMaterial   AscensionMaterial @relation(fields: [ascensionMaterialId], references: [id])
  ascensionMaterialId Int
  material            Material          @relation(fields: [materialId], references: [id])
  materialId          Int
}

// ── Normal Attack ─────────────────────────────────────────────────────────────

model NormalAttack {
  id               Int                       @id @default(autoincrement())
  unlock           String?
  upgrades         TalentUpgrade[]
  character        Character                 @relation(fields: [characterId], references: [id])
  characterId      Int
  translations     NormalAttackTranslation[]
}

model NormalAttackTranslation {
  id             Int                       @id @default(autoincrement())
  language       String
  name           String
  normalAttack   NormalAttack              @relation(fields: [normalAttackId], references: [id])
  normalAttackId Int
  descriptions   NormalAttackDescription[]

  @@unique([normalAttackId, language])
}

model NormalAttackDescription {
  id                      Int                     @id @default(autoincrement())
  title                   String?
  description             String
  normalAttackTranslation NormalAttackTranslation @relation(fields: [translationId], references: [id])
  translationId           Int
}

// ── Elemental Skill ───────────────────────────────────────────────────────────

model ElementalSkill {
  id               Int                         @id @default(autoincrement())
  unlock           String?
  upgrades         TalentUpgrade[]
  character        Character                   @relation(fields: [characterId], references: [id])
  characterId      Int
  translations     ElementalSkillTranslation[]
}

model ElementalSkillTranslation {
  id               Int                         @id @default(autoincrement())
  language         String
  name             String
  note             String
  elementalSkill   ElementalSkill              @relation(fields: [elementalSkillId], references: [id])
  elementalSkillId Int
  descriptions     ElementalSkillDescription[]

  @@unique([elementalSkillId, language])
}

model ElementalSkillDescription {
  id            Int                       @id @default(autoincrement())
  title         String?
  description   String
  translation   ElementalSkillTranslation @relation(fields: [translationId], references: [id])
  translationId Int
}

// ── Elemental Burst ───────────────────────────────────────────────────────────

model ElementalBurst {
  id               Int                         @id @default(autoincrement())
  unlock           String?
  upgrades         TalentUpgrade[]
  character        Character                   @relation(fields: [characterId], references: [id])
  characterId      Int
  translations     ElementalBurstTranslation[]
}

model ElementalBurstTranslation {
  id               Int                         @id @default(autoincrement())
  language         String
  name             String
  note             String
  elementalBurst   ElementalBurst              @relation(fields: [elementalBurstId], references: [id])
  elementalBurstId Int
  descriptions     ElementalBurstDescription[]

  @@unique([elementalBurstId, language])
}

model ElementalBurstDescription {
  id            Int                       @id @default(autoincrement())
  title         String?
  description   String
  translation   ElementalBurstTranslation @relation(fields: [translationId], references: [id])
  translationId Int
}

// ── Passive Talent ────────────────────────────────────────────────────────────

model PassiveTalent {
  id           Int                        @id @default(autoincrement())
  unlock       String?
  character    Character                  @relation(fields: [characterId], references: [id])
  characterId  Int
  attributes   PassiveTalentAttribute[]
  translations PassiveTalentTranslation[]
}

model PassiveTalentTranslation {
  id              Int                      @id @default(autoincrement())
  language        String
  name            String
  note            String?
  passiveTalent   PassiveTalent            @relation(fields: [passiveTalentId], references: [id])
  passiveTalentId Int
  descriptions    PassiveTalentDescription[]

  @@unique([passiveTalentId, language])
}

model PassiveTalentDescription {
  id            Int                      @id @default(autoincrement())
  title         String?
  description   String
  translation   PassiveTalentTranslation @relation(fields: [translationId], references: [id])
  translationId Int
}

model PassiveTalentAttribute {
  id              Int                              @id @default(autoincrement())
  passiveTalent   PassiveTalent                   @relation(fields: [passiveTalentId], references: [id])
  passiveTalentId Int
  translations    PassiveTalentAttributeTranslation[]
}

model PassiveTalentAttributeTranslation {
  id          Int                    @id @default(autoincrement())
  language    String
  name        String
  value       String
  attribute   PassiveTalentAttribute @relation(fields: [attributeId], references: [id])
  attributeId Int

  @@unique([attributeId, language])
}

// ── Ascension Talent ──────────────────────────────────────────────────────────

model AscensionTalent {
  id           Int                          @id @default(autoincrement())
  unlock       String?
  character    Character                    @relation(fields: [characterId], references: [id])
  characterId  Int
  translations AscensionTalentTranslation[]
}

model AscensionTalentTranslation {
  id                Int                        @id @default(autoincrement())
  language          String
  name              String
  ascensionTalent   AscensionTalent            @relation(fields: [ascensionTalentId], references: [id])
  ascensionTalentId Int
  descriptions      AscensionTalentDescription[]

  @@unique([ascensionTalentId, language])
}

model AscensionTalentDescription {
  id            Int                        @id @default(autoincrement())
  title         String?
  description   String
  translation   AscensionTalentTranslation @relation(fields: [translationId], references: [id])
  translationId Int
}

// ── Additional Talent ─────────────────────────────────────────────────────────

model AdditionalTalent {
  id           Int                           @id @default(autoincrement())
  unlock       String?
  character    Character                     @relation(fields: [characterId], references: [id])
  characterId  Int
  translations AdditionalTalentTranslation[]
}

model AdditionalTalentTranslation {
  id                 Int                           @id @default(autoincrement())
  language           String
  name               String
  additionalTalent   AdditionalTalent              @relation(fields: [additionalTalentId], references: [id])
  additionalTalentId Int
  descriptions       AdditionalTalentDescription[]

  @@unique([additionalTalentId, language])
}

model AdditionalTalentDescription {
  id            Int                         @id @default(autoincrement())
  title         String?
  description   String
  translation   AdditionalTalentTranslation @relation(fields: [translationId], references: [id])
  translationId Int
}

// ── Constellation ─────────────────────────────────────────────────────────────

model Constellation {
  id           Int                        @id @default(autoincrement())
  level        Int
  character    Character                  @relation(fields: [characterId], references: [id])
  characterId  Int
  translations ConstellationTranslation[]
}

model ConstellationTranslation {
  id                      Int                               @id @default(autoincrement())
  language                String
  name                    String
  constellation           Constellation                     @relation(fields: [constellationId], references: [id])
  constellationId         Int
  descriptions            ConstellationDescription[]
  hexereiBuffDescriptions ConstellationHexereiDescription[] @relation("hexerei")

  @@unique([constellationId, language])
}

model ConstellationDescription {
  id            Int                      @id @default(autoincrement())
  title         String?
  description   String
  translation   ConstellationTranslation @relation(fields: [translationId], references: [id])
  translationId Int
}

model ConstellationHexereiDescription {
  id            Int                      @id @default(autoincrement())
  title         String?
  description   String
  translation   ConstellationTranslation @relation(fields: [translationId], references: [id], name: "hexerei")
  translationId Int
}

// ── TalentUpgrade ─────────────────────────────────────────────────────────────

model TalentUpgrade {
  id               Int            @id @default(autoincrement())
  values           String[]
  translations     TalentUpgradeTranslation[]

  normalAttackId   Int?
  normalAttack     NormalAttack?  @relation(fields: [normalAttackId], references: [id])

  elementalSkillId Int?
  elementalSkill   ElementalSkill? @relation(fields: [elementalSkillId], references: [id])

  elementalBurstId Int?
  elementalBurst   ElementalBurst? @relation(fields: [elementalBurstId], references: [id])
}

model TalentUpgradeTranslation {
  id        Int           @id @default(autoincrement())
  language  String
  name      String
  upgrade   TalentUpgrade @relation(fields: [upgradeId], references: [id])
  upgradeId Int

  @@unique([upgradeId, language])
}

// ── Material ──────────────────────────────────────────────────────────────────

model Material {
  id                 Int                     @id @default(autoincrement())
  name               String                  @unique
  rarity             Int?
  categories         MaterialCategories[]
  translations       MaterialTranslation[]
  sources            MaterialSource[]
  sellers            MaterialSeller[]
  usedIn             MaterialUse[]
  usedByCharacters   CharacterMaterialUse[]
  ascensionMaterials AscensionMaterialItem[]
  weaponAscensionMaterials WeaponAscensionMaterialItem[]
}

model MaterialTranslation {
  id          Int      @id @default(autoincrement())
  language    String
  name        String
  description String?
  material    Material @relation(fields: [materialId], references: [id])
  materialId  Int

  @@unique([materialId, language])
}

model MaterialSource {
  id           Int                        @id @default(autoincrement())
  type         MaterialSourceTypes
  minimumLevel Int?
  recipes      AlchemyRecipe[]
  translations MaterialSourceTranslation[]
  material     Material                   @relation(fields: [materialId], references: [id])
  materialId   Int
}

model MaterialSourceTranslation {
  id       Int            @id @default(autoincrement())
  language String
  names    String[]
  source   MaterialSource @relation(fields: [sourceId], references: [id])
  sourceId Int

  @@unique([sourceId, language])
}

model AlchemyRecipe {
  id             Int                        @id @default(autoincrement())
  subtype        AlchemySubTypes
  resultQuantity Int
  ingredients    RecipeIngredient[]
  source         MaterialSource             @relation(fields: [sourceId], references: [id])
  sourceId       Int
}

model RecipeIngredient {
  id           Int                          @id @default(autoincrement())
  quantity     Int
  translations RecipeIngredientTranslation[]
  recipe       AlchemyRecipe                @relation(fields: [recipeId], references: [id])
  recipeId     Int
}

model RecipeIngredientTranslation {
  id           Int              @id @default(autoincrement())
  language     String
  item         String
  ingredient   RecipeIngredient @relation(fields: [ingredientId], references: [id])
  ingredientId Int

  @@unique([ingredientId, language])
}

model MaterialSeller {
  id           Int                       @id @default(autoincrement())
  cost         Int
  stock        Int
  restock      RestockType
  translations MaterialSellerTranslation[]
  material     Material                  @relation(fields: [materialId], references: [id])
  materialId   Int
}

model MaterialSellerTranslation {
  id       Int            @id @default(autoincrement())
  language String
  name     String
  currency String
  seller   MaterialSeller @relation(fields: [sellerId], references: [id])
  sellerId Int

  @@unique([sellerId, language])
}

model MaterialUse {
  id           Int                    @id @default(autoincrement())
  translations MaterialUseTranslation[]
  material     Material               @relation(fields: [materialId], references: [id])
  materialId   Int
}

model MaterialUseTranslation {
  id       Int         @id @default(autoincrement())
  language String
  itemName String
  use      MaterialUse @relation(fields: [useId], references: [id])
  useId    Int

  @@unique([useId, language])
}

model CharacterMaterialUse {
  id          Int                   @id @default(autoincrement())
  type        CharacterMaterialType
  material    Material              @relation(fields: [materialId], references: [id])
  materialId  Int
  character   Character             @relation(fields: [characterId], references: [id])
  characterId Int
}

// ── Weapon ──────────────────────────────────────────────────────────────────

model Weapon {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique
  rarity             Int
  type               WeaponTypes
  releaseDate        DateTime?
  translations       WeaponTranslation[]
  levels             WeaponLevel[]
  ascensionMaterials WeaponAscensionMaterial[]
  sellers            WeaponSeller[]
  banners            BannerWeapon[]
}

model WeaponTranslation {
  id          Int      @id @default(autoincrement())
  language    String
  name        String
  description String?
  history     String?
  weapon      Weapon   @relation(fields: [weaponId], references: [id])
  weaponId    Int

  @@unique([weaponId, language])
}

model WeaponLevel {
  id       Int    @id @default(autoincrement())
  level    String // "1", "2", ..., "20_ASC", "21"...
  baseAtk  Int
  weapon   Weapon @relation(fields: [weaponId], references: [id])
  weaponId Int
}

model WeaponAscensionMaterial {
  id       Int                           @id @default(autoincrement())
  level    Int
  weapon   Weapon                        @relation(fields: [weaponId], references: [id])
  weaponId Int
  items    WeaponAscensionMaterialItem[]
}

model WeaponAscensionMaterialItem {
  id                        Int                     @id @default(autoincrement())
  quantity                  Int
  ascensionMaterial         WeaponAscensionMaterial @relation(fields: [ascensionMaterialId], references: [id])
  ascensionMaterialId       Int
  material                  Material                @relation(fields: [materialId], references: [id])
  materialId                Int
}

model WeaponSeller {
  id           Int                       @id @default(autoincrement())
  cost         Int
  stock        Int
  restock      RestockType
  translations WeaponSellerTranslation[]
  weapon       Weapon                    @relation(fields: [weaponId], references: [id])
  weaponId     Int
}

model WeaponSellerTranslation {
  id       Int          @id @default(autoincrement())
  language String
  name     String
  currency String
  seller   WeaponSeller @relation(fields: [sellerId], references: [id])
  sellerId Int

  @@unique([sellerId, language])
}

// ── Banner ──────────────────────────────────────────────────────────────────

model Banner {
  id          Int               @id @default(autoincrement())
  name        String
  type        BannerTypes
  releaseDate DateTime
  endDate     DateTime
  translations BannerTranslation[]
  characters  BannerCharacter[]
  weapons     BannerWeapon[]
}

model BannerCharacter {
  id          Int           @id @default(autoincrement())
  rarity      Int
  role        FeaturedRoles
  banner      Banner        @relation(fields: [bannerId], references: [id])
  bannerId    Int
  character   Character     @relation(fields: [characterId], references: [id])
  characterId Int

  @@unique([bannerId, characterId])
}

model BannerWeapon {
  id        Int           @id @default(autoincrement())
  rarity    Int
  role      FeaturedRoles
  banner    Banner        @relation(fields: [bannerId], references: [id])
  bannerId  Int
  weapon    Weapon        @relation(fields: [weaponId], references: [id])
  weaponId  Int

  @@unique([bannerId, weaponId])
}

model BannerTranslation {
  id       Int    @id @default(autoincrement())
  language String
  name     String
  banner   Banner @relation(fields: [bannerId], references: [id])
  bannerId Int

  @@unique([bannerId, language])
}

// ── Enums ─────────────────────────────────────────────────────────────────────
// ─ Characters ────────────────────────────────────────────────────────────────
enum ObtainingTypes {
  STANDARD_WISHES
  CHRONICLED_WISHES
  CHARACTER_EVENT_WISHES
}

enum UnlockTypes {
  DEFAULT_UNLOCK
  ASCENSION_1_UNLOCK
  ASCENSION_2_UNLOCK
  ASCENSION_3_UNLOCK
  ASCENSION_4_UNLOCK
  ASCENSION_5_UNLOCK
  ASCENSION_6_UNLOCK
  WITCH_HOMEWORK_UNLOCK
}

// ─ Materials ─────────────────────────────────────────────────────────────────
enum MaterialCategories {
  NAGADUS_EMERALD
  VARUNADA_LAZURITE
  ASCENSION_GEMS
}

enum MaterialSourceTypes {
  COMMON_ENEMY
  BOSS
  WEEKLY_BOSS
  ALCHEMY
}

enum AlchemySubTypes {
  CRAFTING
  CONVERTING
}

enum RestockType {
  NEVER
  DAILY
  WEEKLY
  MONTHLY
  THREE_DAYS
}

enum CharacterMaterialType {
  ASCENSION
  TALENT
}

// ─ Weapon ─────────────────────────────────────────────────────────────────

enum WeaponTypes {
  SWORD
  CLAYMORE
  POLEARM
  BOW
  CATALYST
}

// ─ Banner ─────────────────────────────────────────────────────────────────

enum BannerTypes {
  CHARACTER
  WEAPON
}

enum FeaturedRoles {
  BOOSTED
  OTHER
}