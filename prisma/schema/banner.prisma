// ── Banner ──────────────────────────────────────────────────────────────────
//
// BannerCharacter/BannerWeapon (jonction avec Character/Weapon) sont définis
// dans shared.prisma.

model Banner {
  id           Int                 @id @default(autoincrement())
  name         String
  type         BannerTypes
  releaseDate  DateTime
  endDate      DateTime? // null pour les bannières permanentes (novice/standard)
  mechanic     BannerMechanic? // uniquement renseigné pour les bannières chronicled
  translations BannerTranslation[]
  characters   BannerCharacter[]
  weapons      BannerWeapon[]

  @@unique([name, releaseDate])
}

model BannerTranslation {
  id       Int    @id @default(autoincrement())
  language String
  name     String
  banner   Banner @relation(fields: [bannerId], references: [id])
  bannerId Int

  @@unique([bannerId, language])
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum BannerTypes {
  CHARACTER
  WEAPON
  NOVICE
  STANDARD
  CHRONICLED
}

enum BannerMechanic {
  CHRONICLED
  LIGHTRACE
}

enum FeaturedRoles {
  BOOSTED
  OTHER
}
